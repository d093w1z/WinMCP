<Project>

  <PropertyGroup>
    <!-- Windows 10 1809+ : required for the per-monitor DPI APIs (M0 finding: CA1416 on net10.0-windows). -->
    <WinMcpWindowsTfm>net10.0-windows10.0.17763.0</WinMcpWindowsTfm>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Version>1.0.0</Version>
    <Product>WinMCP</Product>
    <Copyright>Copyright 2026 d093w1z. Licensed under the Apache License, Version 2.0.</Copyright>
  </PropertyGroup>

</Project>
