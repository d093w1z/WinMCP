<Project Sdk="Microsoft.NET.Sdk">

  <!-- Real UI Automation against samples/WinMcp.TestApp. Needs an interactive desktop; tests carry Category=Windows. -->
  <PropertyGroup>
    <TargetFramework>$(WinMcpWindowsTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- LibraryImport (PostMessage in HungTargetTests) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FlaUI.UIA3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinMcp.Windows\WinMcp.Windows.csproj" />
    <!-- Build-order dependency only; the app is launched as a separate process from its own output folder. -->
    <ProjectReference Include="..\..\samples\WinMcp.TestApp\WinMcp.TestApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestAppPath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\samples\WinMcp.TestApp\bin\$(Configuration)\$(TargetFramework)\WinMcp.TestApp.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
