<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- Matches the Microsoft.Testing.Platform version xunit.v3 4.0.1 brings in. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.0" />
  </ItemGroup>

</Project>
